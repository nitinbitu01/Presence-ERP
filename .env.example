# .env.example
# Copy to .env and fill in real values.
# NEVER commit .env to git.

# ─── Database ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_erp
DB_USER=attendance_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Model paths (override config.yaml defaults if needed) ─────────────────
MODELS_BASE_PATH=models/
SNAPSHOTS_PATH=snapshots/

# ─── Camera RTSP credentials (if applicable) ───────────────────────────────
CAMERA_RTSP_USER=admin
CAMERA_RTSP_PASSWORD=CHANGE_ME

# ─── API security ──────────────────────────────────────────────────────────
API_SECRET_KEY=CHANGE_ME_32_CHAR_MINIMUM_RANDOM_STRING

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/attendance.log

# ─── Anti-spoofing (set after liveness decision) ───────────────────────────
LIVENESS_ENABLED=false
