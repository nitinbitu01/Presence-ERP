# ============================================================
# Presence ERP — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
#
# To rotate compromised keys:
#   Resend:   https://resend.com/api-keys  → Revoke & create new
#   Supabase: Project Settings → API → Regenerate anon key
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Project ID (safe to expose — used to construct URLs)
SUPABASE_PROJECT_ID=your_supabase_project_id_here
SUPABASE_URL=https://your_supabase_project_id_here.supabase.co

# Publishable/anon key (safe to expose — protected by RLS)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Vite-prefixed copies for client-side access
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here
VITE_SUPABASE_URL=https://your_supabase_project_id_here.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Resend (Email) ────────────────────────────────────────────
# SERVER-SIDE ONLY — never expose this to the browser
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Biometric Encryption ──────────────────────────────────────
# AES-256-GCM key for face embeddings (base64, 32 bytes)
# Generate: openssl rand -base64 32
BIOMETRIC_ENC_KEY=REPLACE_WITH_64_CHAR_HEX_OR_BASE64_32_BYTE_KEY

# HMAC key for liveness challenges
# Generate: openssl rand -base64 32
LIVENESS_HMAC_KEY=REPLACE_WITH_HMAC_SECRET

# ── ID Card Signing ───────────────────────────────────────────
# HMAC key for student ID card QR tokens
ID_CARD_SECRET=REPLACE_WITH_ID_CARD_SECRET

# ── Hardware / RFID (optional) ───────────────────────────────
# HARDWARE_CHECKIN_TYPE=rfid
# RFID_HOST=192.168.1.100
# RFID_PORT=4370

# ── Observability (optional) ─────────────────────────────────
# Endpoint for error-observability.ts batched error submission
# e.g. https://sentry.io/api/PROJECT_ID/store/ or your own endpoint
OBSERVABILITY_ENDPOINT=

# ── Razorpay (Fee Payments) ───────────────────────────────────
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET

# ── Public Site URL ───────────────────────────────────────────
PUBLIC_SITE_URL=https://your-deployment-url.pages.dev

# ── WebAuthn Policy ───────────────────────────────────────────
# Controls Gate 5 (device attestation). MUST be set explicitly — do not rely on
# the code default. Verify at runtime by grepping Cloudflare logs for:
#   [Gate2c] WebAuthn policy resolved: mandatory
# before Day-6 scripted-API demo or the gate will appear to not fire.
# Options: mandatory (default, blocks check-in without device) | recommended | optional
WEBAUTHN_POLICY=mandatory

# ── Security Alerts (Discord / Slack webhook) ─────────────────
# Required for the Day-8 multi-student device-sharing demo to fire a live alert.
# Create: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL
#         Slack  → App → Incoming Webhooks → Add New Webhook → Copy URL
# The payload shape ({ text: "..." }) is understood natively by both.
ALERT_WEBHOOK_URL=
