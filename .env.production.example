# Production Environment Variables Template
# Copy this file to .env.production in your deployment platform's secrets manager
# DO NOT commit actual keys to version control

# ==========================================
# Supabase Configuration
# ==========================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side operations (kept in deployment platform secrets only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# Cryptographic Keys (Generated via Node.js crypto.randomBytes(32).toString('base64'))
# ==========================================
# AES-GCM-256 key for encrypting biometric embeddings
# Generate with: node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(32).toString('base64'))"
BIOMETRIC_ENC_KEY=eWhHjPFm6kFJBTtfN+EdCR8l9iiLOVT5QyK+rJ71fcA=

# HMAC-SHA256 key for liveness challenge signing
# Generate with: node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(32).toString('base64'))"
LIVENESS_HMAC_KEY=chY/cxITYpGZlUTNNSEFRMHXIPBLtSEZylJX2hm21ac=

# ==========================================
# Email Service (Resend)
# ==========================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# Optional: Error Tracking & Analytics
# ==========================================
# Sentry DSN for error tracking (optional but recommended for production)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# Feature Flags & Configuration
# ==========================================
# Enable detailed logging in production (set to false for performance)
DEBUG_LOGGING=false

# Attendance verification timeout in seconds
VERIFICATION_TIMEOUT=300

# GPS accuracy threshold in meters (for sanity checking)
GPS_ACCURACY_THRESHOLD=50

# ==========================================
# Deployment Notes
# ==========================================
# 1. Generate new BIOMETRIC_ENC_KEY and LIVENESS_HMAC_KEY using the Node.js command above
# 2. Store BIOMETRIC_ENC_KEY and LIVENESS_HMAC_KEY in your deployment platform's secrets manager
# 3. Never commit actual keys to version control
# 4. Rotate cryptographic keys every 90 days for security
# 5. After deployment, test email delivery by triggering a role request
# 6. Verify database connectivity by checking the admin dashboard
